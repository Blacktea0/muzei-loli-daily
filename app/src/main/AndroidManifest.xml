<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoliDaily"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main activity — launched from Muzei's source config and app drawer -->
        <activity
            android:name="me.eroi.lolidaily.muzei.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth login — WebView-based Bangumi OAuth for reaction submission -->
        <activity
            android:name="me.eroi.lolidaily.muzei.LoginActivity"
            android:exported="false"
            android:label="Login to Bangumi" />

        <!-- Additional settings — developer tools and testing options -->
        <activity
            android:name="me.eroi.lolidaily.muzei.AdditionalSettingsActivity"
            android:exported="false"
            android:label="Additional Settings" />

        <!-- About — app info, links, and FAQ -->
        <activity
            android:name="me.eroi.lolidaily.muzei.AboutActivity"
            android:exported="false"
            android:label="About" />


        <!-- BroadcastReceiver for force-refresh command from Muzei -->
        <receiver
            android:name=".RefreshReceiver"
            android:exported="false" />

        <!-- App-owned daily refresh alarm; enqueues the Worker inside the configured window -->
        <receiver
            android:name=".DailyRefreshReceiver"
            android:exported="false" />

        <!-- Recreates the daily refresh alarm after system scheduling state changes -->
        <receiver
            android:name=".DailyRefreshRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Muzei Art Provider — discovered by the Muzei app -->
        <provider
            android:name=".LoliDailyArtProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:label="@string/source_title"
            android:description="@string/source_description"
            android:permission="com.google.android.apps.muzei.api.ACCESS_PROVIDER">
            <intent-filter>
                <action android:name="com.google.android.apps.muzei.api.MuzeiArtProvider" />
            </intent-filter>
            <meta-data
                android:name="settingsActivity"
                android:value="me.eroi.lolidaily.muzei.MainActivity" />
        </provider>

        <!-- FileProvider — serves local cached images to Muzei -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- DocumentsProvider — allows Muzei to access artwork files -->
        <provider
            android:name="com.google.android.apps.muzei.api.provider.MuzeiArtDocumentsProvider"
            android:authorities="${applicationId}.provider.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
